# 本地备份服务配置模板。复制为 .env 后按实际环境修改。
BACKUP_SERVER_PORT=18080
BACKUP_LOG_FILE=D:/YiGongBao/backup/logs/yigongbao-backup-server.log
BACKUP_LOG_LEVEL=INFO

# MySQL
BACKUP_DB_URL=jdbc:mysql://127.0.0.1:3307/yigongbao_backup?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
BACKUP_DB_USERNAME=backup
BACKUP_DB_PASSWORD=change-me

# 本地热备和冷备导入目录
BACKUP_HOT_ROOT=D:/YiGongBao/backup/data
BACKUP_COLD_IMPORT_ROOT=D:/YiGongBao/backup/cold-import
BACKUP_MANAGED_STORAGE_ROOTS=D:/YiGongBao/backup/data,D:/YiGongBao/backup/cold-disks

# 线上医工宝通信；联调前保持 false
BACKUP_ONLINE_ENABLED=false
YIGONGBAO_ONLINE_BASE_URL=http://127.0.0.1:8080
BACKUP_ONLINE_AUTH_MODE=HMAC
BACKUP_HMAC_KEY_ID=
BACKUP_HMAC_KEY_SECRET=

# 可选：指定其他 .env 文件路径
# BACKUP_ENV_FILE=D:/YiGongBao/backup/.env
