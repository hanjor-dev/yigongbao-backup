# 医工宝备份服务生产配置模板。客户首次运行前必须按现场环境修改。
SPRING_PROFILES_ACTIVE=prod
BACKUP_SERVER_PORT=18080

# MySQL
BACKUP_DB_URL=jdbc:mysql://127.0.0.1:3306/yigongbao_backup?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia%2FShanghai
BACKUP_DB_USERNAME=yigongbao_backup_app
BACKUP_DB_PASSWORD=change-me

# Spring multipart协议层硬上限；补传业务限制在系统配置页面维护
BACKUP_MAX_UPLOAD_SIZE=2GB

# 本地和线上系统必须配置同一共享密钥（建议至少32位随机字符）。
# 密钥只放环境文件，不写入数据库、日志或HTTP请求。
BACKUP_SHARED_HMAC_SECRET=
# 对象存储预签名 URL 允许主机，逗号分隔；支持 *.example.com。
# online.enabled=true 时此项必填；填写线上文件服务实际生成的 COS/OSS URL 主机，不要包含协议和路径。
BACKUP_EXTERNAL_ALLOWED_HOSTS=

# 订单备份执行模式：REAL=真实下载备份；METADATA_SIMULATION=仅拉取真实元数据并生成零字节模拟制品。
# 生产环境必须使用 REAL；单个任务订单上限在系统配置中动态维护。
BACKUP_EXECUTION_MODE=REAL
# 仅在 METADATA_SIMULATION 下使用，必须与正式 data/orders 目录隔离。
BACKUP_SIMULATION_ROOT=

# 可选：指定其他 .env 文件路径
# BACKUP_ENV_FILE=D:/YiGongBao/backup/.env
