# 本地备份服务配置模板。复制为 .env 后按实际环境修改。
SPRING_PROFILES_ACTIVE=prod
BACKUP_SERVER_PORT=18080
BACKUP_LOG_FILE=D:/YiGongBao/backup/logs/yigongbao-backup-server.log
BACKUP_LOG_LEVEL=INFO

# MySQL
BACKUP_DB_URL=jdbc:mysql://127.0.0.1:3307/yigongbao_backup?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
BACKUP_DB_USERNAME=backup
BACKUP_DB_PASSWORD=change-me

# Spring multipart协议层硬上限；补传业务限制在系统配置页面维护
BACKUP_MAX_UPLOAD_SIZE=2GB

# 本地和线上系统必须配置同一共享密钥（建议至少32位随机字符）。
# 密钥只放环境文件，不写入数据库、日志或HTTP请求。
BACKUP_SHARED_HMAC_SECRET=
# 仅本地联调使用；需要小批量测试时在本机 .env 改为5，生产必须保持0或删除。
BACKUP_DEV_CANDIDATE_LIMIT=0

# 订单备份执行模式：REAL=真实下载备份；METADATA_SIMULATION=仅拉取真实元数据并生成零字节模拟制品。
# 生产环境必须使用 REAL；0 表示候选订单不设开发测试上限。
BACKUP_EXECUTION_MODE=REAL
# 仅在 METADATA_SIMULATION 下使用，必须与正式 data/orders 目录隔离。
BACKUP_SIMULATION_ROOT=D:/YiGongBao/backup/simulation

# 可选：指定其他 .env 文件路径
# BACKUP_ENV_FILE=D:/YiGongBao/backup/.env
